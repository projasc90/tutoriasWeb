# Variables de entorno del frontend (web/)
# Copia este archivo a .env.local y ajusta los valores.
# NUNCA subas .env.local al repo (está ignorado por git).

# URL base de la API .NET (backend).
# - Dev local: puerto de launchSettings.json (5037).
# - Prod (Vercel): URL pública de la API en Vercel Container, sin slash final.
#   Configurar en Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_API_URL=http://localhost:5037

# ── Vercel Blob (ADR-009) ──────────────────────────────────────────
# Almacenamiento de documentos de verificación y fotos de perfil.
# Se obtienen al crear el store: Vercel → Storage → Create → Blob (acceso Private).
# AMBOS son secretos de servidor: nunca con prefijo NEXT_PUBLIC_.
# Sin BLOB_READ_WRITE_TOKEN, /api/blob/upload responde 501 y las subidas
# degradan al multipart clásico (solo válido en desarrollo local).
#
# ⚠️ Son los MISMOS nombres que lee el API .NET (`VercelBlobConfiguration`):
#    el store se configura una sola vez. `BLOB_STORE_ID` llega como `store_<id>`;
#    el API quita el prefijo para construir la URL del blob.
BLOB_STORE_ID="store_xxxxxxxxxxxxxxxx"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
